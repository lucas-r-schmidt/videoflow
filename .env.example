# ═══════════════════════════════════════════════════════════════
#  .env.example — copie para .env e preencha os valores reais
#  NUNCA commite o .env real no git
# ═══════════════════════════════════════════════════════════════

# ── Aplicação ─────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=troque-por-string-aleatoria-32-chars

# ── Banco de dados (PostgreSQL) ───────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=video_automation
DB_USER=app
DB_PASSWORD=troque-por-senha-forte
DATABASE_URL=postgresql+asyncpg://app:troque-por-senha-forte@postgres:5432/video_automation

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Segurança — criptografia de tokens OAuth ──────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=cole-aqui-a-chave-gerada-pelo-comando-acima

# ═══════════════════════════════════════════════════════════════
#  INSTAGRAM GRAPH API
#  Docs: https://developers.facebook.com/docs/instagram-api
# ═══════════════════════════════════════════════════════════════
# Crie um app em: https://developers.facebook.com/apps
INSTAGRAM_APP_ID=seu_facebook_app_id
INSTAGRAM_APP_SECRET=seu_facebook_app_secret
INSTAGRAM_REDIRECT_URI=https://seudominio.com/auth/instagram/callback

# Escopos necessários:
#   instagram_basic, instagram_content_publish, pages_show_list
# Tokens são armazenados por usuário no banco (criptografados)

# ═══════════════════════════════════════════════════════════════
#  TIKTOK CONTENT POSTING API v2
#  Docs: https://developers.tiktok.com/doc/content-posting-api-get-started
# ═══════════════════════════════════════════════════════════════
# Crie um app em: https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=seu_tiktok_client_key
TIKTOK_CLIENT_SECRET=seu_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://seudominio.com/auth/tiktok/callback

# Escopos necessários: video.publish, video.upload
# access_token dura 24h; refresh_token dura 365 dias

# ═══════════════════════════════════════════════════════════════
#  GOOGLE DRIVE API
#  Docs: https://developers.google.com/drive/api/guides/about-sdk
# ═══════════════════════════════════════════════════════════════
# Crie credenciais OAuth em: https://console.cloud.google.com/apis/credentials
# Tipo: OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_REDIRECT_URI=https://seudominio.com/auth/google/callback

# Escopos: https://www.googleapis.com/auth/drive.readonly

# ═══════════════════════════════════════════════════════════════
#  WHISPER (local — sem custo de API)
# ═══════════════════════════════════════════════════════════════
# Opções: large-v3-turbo, distil-large-v3, base, small, medium
# large-v3-turbo via faster-whisper int8 = ultra rápido e máxima precisão PT-BR
WHISPER_MODEL=large-v3-turbo

# Diretório de cache dos modelos (mapeado para volume Docker)
WHISPER_CACHE_DIR=/root/.cache/whisper

# ═══════════════════════════════════════════════════════════════
#  LLM (Google Gemini / Groq / Cerebras / OpenRouter / OpenAI / Ollama)
# ═══════════════════════════════════════════════════════════════
# Opção Recomendada (Google AI Studio — 100% Grátis, 15 RPM, 1.500 req/dia):
# Crie chave grátis em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash

# Opção de Alta Velocidade Grátis (Groq):
# Crie chave grátis em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Opção Ultra Rápida Grátis (Cerebras AI — tier grátis 30 RPM):
# Crie chave em: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Opção Grátis de Fallback Amplo (OpenRouter — modelos :free):
# Crie chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Opção Alternativa Comercial:
OPENAI_API_KEY=sk-...

# Opção Local (Ollama - consome memória da VM):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:mini

# ═══════════════════════════════════════════════════════════════
#  YT-DLP PO TOKEN (Proof of Origin anti-bloqueio de IP do YouTube)
# ═══════════════════════════════════════════════════════════════
# Gerado via bgutil-ytdlp-pot-provider ou manual:
YTDLP_PO_TOKEN=

# ═══════════════════════════════════════════════════════════════
#  CLOUDFLARE WORKERS AI (Whisper Grátis — 10.000 neurônios/dia ~4h áudio)
# ═══════════════════════════════════════════════════════════════
# Crie API Token com permissão "Workers AI: Read/Write" no Cloudflare Dashboard
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# ═══════════════════════════════════════════════════════════════
#  COBALT API (Download Alternativo Anti-Bloqueio de IP / YouTube)
# ═══════════════════════════════════════════════════════════════
# URL da instância Cobalt (self-hosted Docker ou pública):
# Exemplo Docker: http://cobalt:9000
COBALT_API_URL=

# ═══════════════════════════════════════════════════════════════
#  CLOUDFLARE R2 STORAGE (S3-Compatible — 10 GB Grátis / Zero Egress)
# ═══════════════════════════════════════════════════════════════
# Obtenha em: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública do bucket (R2.dev ou domínio customizado vinculado):
R2_PUBLIC_URL=

# ═══════════════════════════════════════════════════════════════
#  STORAGE (local via volumes Docker)
# ═══════════════════════════════════════════════════════════════
VIDEO_TMP_DIR=/tmp/videos
VIDEO_OUTPUT_DIR=/app/outputs

# Tempo máximo que um vídeo temporário fica em disco (segundos)
# Após publicação, o job limpa automaticamente
VIDEO_CLEANUP_AFTER_SECONDS=3600

# ═══════════════════════════════════════════════════════════════
#  CELERY — ajustes de performance
# ═══════════════════════════════════════════════════════════════
# Timeout máximo de uma task de processamento (segundos)
# Vídeos longos podem demorar — 30 min é seguro
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=2100

# ═══════════════════════════════════════════════════════════════
#  NGINX / SSL
# ═══════════════════════════════════════════════════════════════
DOMAIN=seudominio.com
CERTBOT_EMAIL=seu@email.com
